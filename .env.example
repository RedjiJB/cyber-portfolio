# OpenAI API key
OPENAI_API_KEY=your_openai_api_key_here

# Contact form (optional): create a service + template at emailjs.com and fill these in.
# Without them the form opens the visitor's mail app (mailto) instead of sending directly.
REACT_APP_EMAILJS_SERVICE_ID=
REACT_APP_EMAILJS_TEMPLATE_ID=
REACT_APP_EMAILJS_PUBLIC_KEY=
